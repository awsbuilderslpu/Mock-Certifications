{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mock-certifications",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "routes": [
    {
      "pattern": "mock.awslpu.in",
      "zone_name": "awslpu.in",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mock-certifications",
      "environment": "production"
    }
  ],

  "images": {
    "binding": "IMAGES"
  }
}